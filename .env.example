# Copy to .env (or export these in your shell) before running the Flask app.

# Folder containing runDRPipelineProduction.m and the Module 1-5 .m files
MATLAB_SRC_DIR=C:\path\to\drishti\matlab

# Path to the trained classifier. If this file is missing the pipeline
# automatically falls back to real_no_cnn (rule-based) mode.
DR_MODEL_PATH=C:\path\to\drishti\models\drClassifier.mat

# Optional. Without it, PDF reports use a built-in fallback paragraph.
GEMINI_API_KEY=
